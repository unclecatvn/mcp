      "brace-expansion@5": "^5.0.12",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "hono@4": "^4.13.7",
      "fast-uri@3": "^3.1.8",
      "ip-address@10": "^10.7.1",
      "nanoid@3": "^3.3.18",
      "postcss@8": "^8.5.23",
      "source-map-js@1": "^1.2.2",
      "proxy-addr@2": "^2.0.8",
      "tinypool@1": "^2.1.2"
    },
    "auditConfig": {
