{
  "name": "@unclecat/mcp-obsidian",
  "version": "0.0.0",
  "description": "MCP server for Obsidian vaults via the filesystem. Works without Obsidian running, supports multiple vaults with per-vault readonly/readwrite mode.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "mcp-obsidian": "index.js"
  },
  "files": [
    "index.js",
    "mcpServer.js",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "markdown",
    "notes",
    "claude"
  ],
  "author": "UncleCat <quangnh.tkcn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unclecatvn/mcp.git",
    "directory": "obsidian"
  },
  "homepage": "https://github.com/unclecatvn/mcp/tree/master/obsidian#readme",
  "bugs": {
    "url": "https://github.com/unclecatvn/mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
